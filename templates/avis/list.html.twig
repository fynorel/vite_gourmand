{% extends "base.html.twig" %}

{% block title %}Avis - Vite & Gourmand{% endblock %}

{% block content %}
<h1 class="mb-4">Avis de nos clients</h1>

{% if avis is empty %}
    <div class="alert alert-info">
        Aucun avis pour le moment.
    </div>
{% else %}
    <div class="row">
        {% for avi in avis %}
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">
                            {% for i in 1..avi.note %}⭐{% endfor %}
                        </h5>
                        <p class="card-text">{{ avi.commentaire }}</p>
                    </div>
                    <div class="card-footer bg-white">
                        <small class="text-muted">
                            <strong>{{ avi.auteur }}</strong> sur 
                            <strong>{{ avi.menu_titre }}</strong><br>
                            {{ avi.date_creation|date('d/m/Y H:i') }}                        </small>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}
{% endblock %}
