<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Vite & Gourmand{% endblock %}</title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    {% block stylesheets %}{% endblock %}
    
    <style>
        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        main {
            flex: 1;
            padding: 20px 0;
        }
        footer {
            background-color: #f8f9fa;
            border-top: 1px solid #dee2e6;
            padding: 20px 0;
            margin-top: 40px;
        }
    </style>
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark 
        {% if app.user %}
            {% if 'ROLE_ADMIN' in app.user.roles %}
                bg-danger
            {% elseif 'ROLE_EMPLOYE' in app.user.roles %}
                bg-success
            {% else %}
                bg-primary
            {% endif %}
        {% else %}
            bg-dark
        {% endif %}
">


        <div class="container">
            <a class="navbar-brand" href="{{ path('app_home') }}">🍽️ Vite & Gourmand</a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_home') }}">Accueil</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_menu_list') }}">Menus</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_avis_list') }}">Avis</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_contact') }}">Contact</a>
                    </li>
                    
                    {% if app.user %}

                        {% if app.user and 'ROLE_USER' in app.user.roles %}                            
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_commande_list') }}">Mes Commandes</a>
                            </li>
                        {% endif %}
                            {% if 'ROLE_EMPLOYE' in app.user.roles or 'ROLE_ADMIN' in app.user.roles %}
                                <li class="nav-item">
                                    <a class="nav-link" href="{{ path('app_dashboard_index') }}">Dashboard</a>
                                </li>
                            {% endif %}

                            {% if 'ROLE_ADMIN' in app.user.roles %}
                                <li class="nav-item">
                                    <a class="nav-link" href="{{ path('app_stats_dashboard') }}">📊 Statistiques</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="{{ path('app_admin_employees_list') }}">👥 Employés</a>
                                </li>
                            {% endif %}
                        
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
                                {{ app.user.prenom }}
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="userDropdown">
                                <li><a class="dropdown-item" href="{{ path('app_profile') }}">Mon Profil</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="{{ path('app_logout') }}">Déconnexion</a></li>
                            </ul>
                        </li>
                    {% else %}
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_login') }}">Connexion</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_register') }}">Inscription</a>
                        </li>
                    {% endif %}
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="container">
        <!-- Afficher les messages flash -->
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{% if type == 'error' %}danger{% elseif type == 'success' %}success{% elseif type == 'info' %}info{% else %}warning{% endif %} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
        {% endfor %}

        {% block content %}{% endblock %}
    </main>

    <!-- Footer -->
    <footer>
        <div class="container text-center">
            <p class="mb-0">&copy; 2024 Vite & Gourmand. Tous droits réservés.</p>
        </div>
    </footer>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    {% block javascripts %}{% endblock %}
</body>
</html>
