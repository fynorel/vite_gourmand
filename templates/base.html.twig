<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Vite & Gourmand{% endblock %}</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    {% block stylesheets %}{% endblock %}

    <style>
        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        main {
            flex: 1;
            padding: 20px 0;
        }
        /* Focus visible pour navigation clavier (RGAA) */
        :focus-visible {
            outline: 3px solid #ffc107;
            outline-offset: 2px;
        }
        /* Lien d'évitement (RGAA) */
        .skip-link {
            position: absolute;
            top: -100px;
            left: 0;
            background: #ffc107;
            color: #000;
            padding: 8px 16px;
            z-index: 9999;
            font-weight: bold;
            border-radius: 0 0 4px 0;
            transition: top 0.2s;
        }
        .skip-link:focus {
            top: 0;
        }
    </style>
</head>
<body>

    <!-- Lien d'évitement (RGAA critère 12.7) -->
    <a href="#main-content" class="skip-link">Aller au contenu principal</a>

    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark
         
         
        {% if app.user %}
            {% if 'ROLE_ADMIN' in app.user.roles %}
                bg-danger
            {% elseif 'ROLE_EMPLOYE' in app.user.roles %}
                bg-success
            {% else %}
                bg-primary
            {% endif %}
        {% else %}
            bg-dark
        {% endif %}"
        aria-label="Menu principal"
        role="navigation">

        <div class="container">
            <a class="navbar-brand" href="{{ path('app_home') }}" aria-label="Vite & Gourmand - Retour à l'accueil">
                🍽️ Vite & Gourmand
            </a>

            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav"
                    aria-controls="navbarNav"
                    aria-expanded="false"
                    aria-label="Ouvrir le menu de navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto" role="menubar">
                    <li class="nav-item" role="none">
                        <a class="nav-link" href="{{ path('app_home') }}" role="menuitem">Accueil</a>
                    </li>
                    <li class="nav-item" role="none">
                        <a class="nav-link" href="{{ path('app_menu_list') }}" role="menuitem">Menus</a>
                    </li>
                    <li class="nav-item" role="none">
                        <a class="nav-link" href="{{ path('app_avis_list') }}" role="menuitem">Avis</a>
                    </li>
                    <li class="nav-item" role="none">
                        <a class="nav-link" href="{{ path('app_contact') }}" role="menuitem">Contact</a>
                    </li>

                    {% if app.user %}
                        {% if 'ROLE_USER' in app.user.roles %}
                        <li class="nav-item" role="none">
                            <a class="nav-link" href="{{ path('app_commande_list') }}" role="menuitem">Mes Commandes</a>
                        </li>
                        {% endif %}

                        {% if 'ROLE_EMPLOYE' in app.user.roles or 'ROLE_ADMIN' in app.user.roles %}
                        <li class="nav-item" role="none">
                            <a class="nav-link" href="{{ path('app_dashboard_index') }}" role="menuitem">Dashboard</a>
                        </li>
                        {% endif %}

                        {% if 'ROLE_ADMIN' in app.user.roles %}
                        <li class="nav-item" role="none">
                            <a class="nav-link" href="{{ path('app_stats_dashboard') }}" role="menuitem">📊 Statistiques</a>
                        </li>
                        <li class="nav-item" role="none">
                            <a class="nav-link" href="{{ path('app_admin_employees_list') }}" role="menuitem">👥 Employés</a>
                        </li>
                        {% endif %}

                        <li class="nav-item dropdown" role="none">
                            <a class="nav-link dropdown-toggle"
                               href="#"
                               id="userDropdown"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-haspopup="true"
                               aria-expanded="false">
                                {{ app.user.prenom }}
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="userDropdown" role="menu">
                                <li role="none">
                                    <a class="dropdown-item" href="{{ path('app_profile') }}" role="menuitem">Mon Profil</a>
                                </li>
                                <li role="none"><hr class="dropdown-divider"></li>
                                <li role="none">
                                    <a class="dropdown-item" href="{{ path('app_logout') }}" role="menuitem">Déconnexion</a>
                                </li>
                            </ul>
                        </li>
                    {% else %}
                        <li class="nav-item" role="none">
                            <a class="nav-link" href="{{ path('app_login') }}" role="menuitem">Connexion</a>
                        </li>
                        <li class="nav-item" role="none">
                            <a class="nav-link" href="{{ path('app_register') }}" role="menuitem">Inscription</a>
                        </li>
                    {% endif %}
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="container" id="main-content" role="main" tabindex="-1">

        <!-- Messages flash (RGAA : role="alert" pour annonce automatique) -->
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{% if type == 'error' %}danger{% elseif type == 'success' %}success{% elseif type == 'info' %}info{% else %}warning{% endif %} alert-dismissible fade show"
                     role="alert"
                     aria-live="polite"
                     aria-atomic="true">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer ce message"></button>
                </div>
            {% endfor %}
        {% endfor %}

        {% block content %}{% endblock %}
    </main>

    <!-- Footer -->
    <footer class="mt-5" style="background-color: #2c2c2c; color: #ccc;" role="contentinfo" aria-label="Pied de page">
        <div class="container py-4">
            <div class="row">

                {# ── Infos entreprise ── #}
                <div class="col-md-4 mb-3">
                    <h2 class="h6 text-white fw-bold">🍽️ Vite & Gourmand</h2>
                    <address class="small mb-0" style="font-style: normal;">
                        <p class="mb-1">12 rue des Chartrons, 33000 Bordeaux</p>
                        <p class="mb-1">
                            <a href="tel:+33556000000" style="color: #ccc; text-decoration: none;"
                               aria-label="Téléphone : 05 56 XX XX XX">
                                📞 05 56 XX XX XX
                            </a>
                        </p>
                        <p class="mb-0">
                            <a href="mailto:contact@vite-gourmand.fr" style="color: #ccc; text-decoration: none;"
                               aria-label="Email : contact@vite-gourmand.fr">
                                ✉️ contact@vite-gourmand.fr
                            </a>
                        </p>
                    </address>
                </div>

                {# ── Horaires ── #}
                <div class="col-md-4 mb-3">
                    <h2 class="h6 text-white fw-bold">🕐 Nos horaires</h2>
                    <table class="table table-sm mb-0" style="color: #ccc; font-size: 0.85rem;"
                           aria-label="Horaires d'ouverture">
                        <caption class="visually-hidden">Horaires d'ouverture de Vite & Gourmand</caption>
                        <tbody>
                            {% for horaire in horaires_footer %}
                            <tr>
                                <td class="border-0 py-0 ps-0">{{ horaire.jourNom }}</td>
                                <td class="border-0 py-0 text-end">
                                    {% if horaire.estFerme %}
                                        <span style="color: #ff6b6b;" aria-label="{{ horaire.jourNom }} : Fermé">Fermé</span>
                                    {% else %}
                                        <span aria-label="{{ horaire.jourNom }} : {{ horaire.heureOuverture|date('H:i') }} à {{ horaire.heureFermeture|date('H:i') }}">
                                            {{ horaire.heureOuverture|date('H:i') }} - {{ horaire.heureFermeture|date('H:i') }}
                                        </span>
                                    {% endif %}
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                {# ── Liens utiles ── #}
                <div class="col-md-4 mb-3">
                    <h2 class="h6 text-white fw-bold">Liens utiles</h2>
                    <nav aria-label="Liens du pied de page">
                        <ul class="list-unstyled small">
                            <li class="mb-1">
                                <a href="{{ path('app_home') }}" class="text-decoration-none" style="color: #ccc;">🏠 Accueil</a>
                            </li>
                            <li class="mb-1">
                                <a href="{{ path('app_menu_list') }}" class="text-decoration-none" style="color: #ccc;">🍽️ Nos menus</a>
                            </li>
                            <li class="mb-1">
                                <a href="{{ path('app_contact') }}" class="text-decoration-none" style="color: #ccc;">📩 Contact</a>
                            </li>
                            <li class="mb-1">
                                <a href="{{ path('app_mentions_legales') }}" class="text-decoration-none" style="color: #ccc;">📄 Mentions légales</a>
                            </li>
                            <li class="mb-1">
                                <a href="{{ path('app_cgv') }}" class="text-decoration-none" style="color: #ccc;">📋 Conditions générales de vente</a>
                            </li>
                        </ul>
                    </nav>
                </div>

            </div>

            <hr style="border-color: #444;" aria-hidden="true">
            <p class="text-center small mb-0" style="color: #888;">
                &copy; {{ "now"|date("Y") }} Vite & Gourmand — Tous droits réservés
            </p>
        </div>
    </footer>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    {% block javascripts %}{% endblock %}
</body>
</html>
