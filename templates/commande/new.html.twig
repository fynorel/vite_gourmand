{% extends "base.html.twig" %}

{% block title %}Nouvelle Commande - Vite & Gourmand{% endblock %}

{% block content %}
<div class="row justify-content-center mb-5">
    <div class="col-md-6">
        <h2 class="mb-4">Créer une commande</h2>

        <form method="post" action="{{ path('app_commande_new') }}">
            <div class="mb-3">
                <label for="menu_id" class="form-label">Menu *</label>
                <select id="menu_id" name="menu_id" class="form-select" required>
                    <option value="">-- Sélectionner un menu --</option>
                    {% for menu in menus %}
                        <option value="{{ menu.id }}">
                            {{ menu.titre }} - {{ menu.prix }}€
                        </option>
                    {% endfor %}
                </select>
            </div>

            <div class="mb-3">
                <label for="nb_personnes" class="form-label">Nombre de personnes *</label>
                <input type="number" id="nb_personnes" name="nb_personnes" class="form-control" 
                       min="1" required>
            </div>

            <div class="mb-3">
                <label for="adresse" class="form-label">Adresse de livraison *</label>
                <textarea id="adresse" name="adresse" class="form-control" rows="3" required></textarea>
            </div>

            <div class="mb-3">
                <label for="date_prestation" class="form-label">Date de prestation *</label>
                <input type="datetime-local" id="date_prestation" name="date_prestation" 
                       class="form-control" required>
            </div>

            <button type="submit" class="btn btn-primary w-100">Créer la commande</button>
        </form>

        <div class="mt-3">
            <a href="{{ path('app_menu_list') }}" class="btn btn-secondary w-100">Retour au catalogue</a>
        </div>
    </div>
</div>
{% endblock %}
