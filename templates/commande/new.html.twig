{% extends 'base.html.twig' %}

{% block title %}Commander un menu - Vite & Gourmand{% endblock %}

{% block content %}
<div class="row justify-content-center">
<div class="col-md-8">

    <h1 class="mb-4">Passer une commande</h1>

    <form method="POST" action="{{ path('app_commande_new') }}" id="commandeForm" novalidate>

        {# ── ÉTAPE 1 : INFOS CLIENT (pré-remplies) ── #}
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">1. Vos informations</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Prénom</label>
                        <input type="text" class="form-control" value="{{ user.prenom }}" disabled aria-disabled="true">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Nom</label>
                        <input type="text" class="form-control" value="{{ user.nom }}" disabled aria-disabled="true">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" class="form-control" value="{{ user.mail }}" disabled aria-disabled="true">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">GSM</label>
                        <input type="text" class="form-control" value="{{ user.gsm }}" disabled aria-disabled="true">
                    </div>
                </div>
            </div>
        </div>

        {# ── ÉTAPE 2 : MENU ── #}
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">2. Choix du menu</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label for="menu_id" class="form-label">Menu <span class="text-danger" aria-hidden="true">*</span></label>
                    <select class="form-select" id="menu_id" name="menu_id"
                            aria-required="true" aria-describedby="menu-error">
                        <option value="">-- Choisir un menu --</option>
                        {% for menu in menus %}
                            {% if menu.stock > 0 %}
                            <option value="{{ menu.id }}"
                                    data-prix="{{ menu.prix }}"
                                    data-min="{{ menu.nbPersonnesMin }}"
                                    {{ menu_selected and menu_selected.id == menu.id ? 'selected' }}>
                                {{ menu.titre }} — {{ menu.prix }} € (min. {{ menu.nbPersonnesMin }} pers.)
                            </option>
                            {% endif %}
                        {% endfor %}
                    </select>
                    <div class="invalid-feedback" id="menu-error" role="alert"></div>
                </div>

                <div class="mb-3">
                    <label for="nb_personnes" class="form-label">
                        Nombre de personnes <span class="text-danger" aria-hidden="true">*</span>
                        <small class="text-muted" id="nb_min_info"></small>
                    </label>
                    <input type="number" class="form-control" id="nb_personnes" name="nb_personnes"
                           min="1" aria-required="true" aria-describedby="nb-error">
                    <div class="invalid-feedback" id="nb-error" role="alert"></div>
                    <div class="form-text text-success" id="reduction_info" style="display:none;">
                        🎉 Réduction de 10% appliquée !
                    </div>
                </div>
            </div>
        </div>

        {# ── ÉTAPE 3 : PRESTATION ── #}
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">3. Lieu et date de la prestation</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label for="adresse" class="form-label">Adresse de livraison <span class="text-danger" aria-hidden="true">*</span></label>
                    <input type="text" class="form-control" id="adresse" name="adresse"
                           value="{{ user.adresse }}"
                           placeholder="Ex : 12 rue des Fleurs, Bordeaux"
                           maxlength="500"
                           aria-required="true"
                           aria-describedby="adresse-error">
                    <div class="form-text">
                        ℹ️ Si l'adresse n'est pas à Bordeaux, des frais de livraison s'appliquent (5€ + 0,59€/km).
                    </div>
                    <div class="invalid-feedback" id="adresse-error" role="alert"></div>
                </div>

                <input type="hidden" id="distance_km" name="distance_km" value="0">

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="date_prestation" class="form-label">Date <span class="text-danger" aria-hidden="true">*</span></label>
                        <input type="date" class="form-control" id="date_prestation" name="date_prestation"
                               min="{{ "now"|date("Y-m-d") }}"
                               aria-required="true"
                               aria-describedby="date-error">
                        <div class="invalid-feedback" id="date-error" role="alert"></div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="heure_prestation" class="form-label">Heure souhaitée <span class="text-danger" aria-hidden="true">*</span></label>
                        <input type="time" class="form-control" id="heure_prestation" name="heure_prestation"
                               value="12:00"
                               aria-required="true"
                               aria-describedby="heure-error">
                        <div class="invalid-feedback" id="heure-error" role="alert"></div>
                    </div>
                </div>
            </div>
        </div>

        {# ── RÉCAPITULATIF PRIX ── #}
        <div class="card shadow-sm mb-4 border-primary" id="recap_prix" style="display:none;" aria-live="polite">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">💶 Récapitulatif du prix</h5>
            </div>
            <div class="card-body">
                <table class="table table-borderless mb-0" aria-label="Détail du prix">
                    <tr>
                        <td>Prix du menu</td>
                        <td class="text-end fw-bold" id="recap_prix_menu">—</td>
                    </tr>
                    <tr id="recap_reduction_row" style="display:none;" class="text-success">
                        <td>Réduction (10%)</td>
                        <td class="text-end fw-bold" id="recap_reduction">—</td>
                    </tr>
                    <tr id="recap_livraison_row" style="display:none;">
                        <td>Frais de livraison</td>
                        <td class="text-end fw-bold" id="recap_livraison">—</td>
                    </tr>
                    <tr class="border-top">
                        <td class="fw-bold fs-5">Total</td>
                        <td class="text-end fw-bold fs-5 text-primary" id="recap_total">—</td>
                    </tr>
                </table>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary btn-lg">✅ Confirmer la commande</button>
            <a href="{{ path('app_menu_list') }}" class="btn btn-secondary btn-lg">Annuler</a>
        </div>

    </form>
</div>
</div>
{% endblock %}

{% block javascripts %}
<script>
// ── Utilitaires ──────────────────────────────────────────────────────────────
function showError(fieldId, errorId, message) {
    const field = document.getElementById(fieldId);
    const error = document.getElementById(errorId);
    if (field) { field.classList.add('is-invalid'); field.classList.remove('is-valid'); }
    if (error) error.textContent = message;
}

function showSuccess(fieldId) {
    const field = document.getElementById(fieldId);
    if (field) { field.classList.remove('is-invalid'); field.classList.add('is-valid'); }
}

function containsMalicious(value) {
    return /<|>|script|javascript:|on\w+=/i.test(value);
}

// ── Validations ──────────────────────────────────────────────────────────────
function validateMenu() {
    const val = document.getElementById('menu_id').value;
    if (!val) { showError('menu_id', 'menu-error', 'Veuillez choisir un menu.'); return false; }
    showSuccess('menu_id'); return true;
}

function validateNbPersonnes() {
    const select = document.getElementById('menu_id');
    const option = select.options[select.selectedIndex];
    const nb     = parseInt(document.getElementById('nb_personnes').value);
    const min    = option && option.dataset.min ? parseInt(option.dataset.min) : 1;

    if (!nb || nb < 1) {
        showError('nb_personnes', 'nb-error', 'Le nombre de personnes est obligatoire.');
        return false;
    }
    if (nb < min) {
        showError('nb_personnes', 'nb-error', 'Le minimum pour ce menu est ' + min + ' personnes.');
        return false;
    }
    // Afficher réduction
    document.getElementById('reduction_info').style.display = nb >= (min + 5) ? '' : 'none';
    showSuccess('nb_personnes');
    return true;
}

function validateAdresse() {
    const val = document.getElementById('adresse').value.trim();
    if (!val) { showError('adresse', 'adresse-error', 'L\'adresse de livraison est obligatoire.'); return false; }
    if (val.length < 10) { showError('adresse', 'adresse-error', 'Veuillez saisir une adresse complète.'); return false; }
    if (containsMalicious(val)) { showError('adresse', 'adresse-error', 'L\'adresse contient des caractères non autorisés.'); return false; }
    showSuccess('adresse');
    return true;
}

function validateDate() {
    const val     = document.getElementById('date_prestation').value;
    const today   = new Date().toISOString().split('T')[0];
    if (!val) { showError('date_prestation', 'date-error', 'La date est obligatoire.'); return false; }
    if (val < today) { showError('date_prestation', 'date-error', 'La date ne peut pas être dans le passé.'); return false; }
    showSuccess('date_prestation');
    return true;
}

function validateHeure() {
    const val = document.getElementById('heure_prestation').value;
    if (!val) { showError('heure_prestation', 'heure-error', 'L\'heure est obligatoire.'); return false; }
    showSuccess('heure_prestation');
    return true;
}

// ── Calcul du prix via AJAX (existant) ───────────────────────────────────────
const menuSelect    = document.getElementById('menu_id');
const nbPersonnes   = document.getElementById('nb_personnes');
const adresseInput  = document.getElementById('adresse');
const reductionInfo = document.getElementById('reduction_info');
const nbMinInfo     = document.getElementById('nb_min_info');
const recapPrix     = document.getElementById('recap_prix');

function updateNbMin() {
    const option = menuSelect.options[menuSelect.selectedIndex];
    if (option && option.dataset.min) {
        const min = parseInt(option.dataset.min);
        nbPersonnes.min = min;
        nbMinInfo.textContent = '(minimum ' + min + ' personnes)';
    }
}

function calculerPrix() {
    const menuId = menuSelect.value;
    const nb     = parseInt(nbPersonnes.value);
    const adresse = adresseInput.value;
    if (!menuId || !nb || nb < 1) return;

    const formData = new FormData();
    formData.append('menu_id',     menuId);
    formData.append('nb_personnes', nb);
    formData.append('adresse',     adresse);
    formData.append('distance_km', document.getElementById('distance_km').value);

    fetch('{{ path('app_commande_calcul_prix') }}', { method: 'POST', body: formData })
        .then(r => r.json())
        .then(data => {
            if (data.error) return;
            recapPrix.style.display = 'block';
            document.getElementById('recap_prix_menu').textContent = data.prix_menu + ' €';
            document.getElementById('recap_total').textContent     = data.prix_total + ' €';
            const reductionRow = document.getElementById('recap_reduction_row');
            if (parseFloat(data.reduction) > 0) {
                reductionRow.style.display = '';
                document.getElementById('recap_reduction').textContent = '- ' + data.reduction + ' €';
                reductionInfo.style.display = '';
            } else {
                reductionRow.style.display = 'none';
                reductionInfo.style.display = 'none';
            }
            const livraisonRow = document.getElementById('recap_livraison_row');
            if (parseFloat(data.frais_livraison) > 0) {
                livraisonRow.style.display = '';
                document.getElementById('recap_livraison').textContent = '+ ' + data.frais_livraison + ' €';
            } else {
                livraisonRow.style.display = 'none';
            }
        });
}

menuSelect.addEventListener('change', () => { updateNbMin(); validateMenu(); calculerPrix(); });
nbPersonnes.addEventListener('input',  () => { validateNbPersonnes(); calculerPrix(); });
adresseInput.addEventListener('blur',  () => { validateAdresse(); calculerPrix(); });
document.getElementById('date_prestation').addEventListener('blur', validateDate);
document.getElementById('heure_prestation').addEventListener('blur', validateHeure);

if (menuSelect.value) { updateNbMin(); }

// ── Soumission ───────────────────────────────────────────────────────────────
document.getElementById('commandeForm').addEventListener('submit', function(e) {
    const valid = [
        validateMenu(),
        validateNbPersonnes(),
        validateAdresse(),
        validateDate(),
        validateHeure()
    ].every(Boolean);

    if (!valid) {
        e.preventDefault();
        const firstError = document.querySelector('.is-invalid');
        if (firstError) firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
});
</script>
{% endblock %}
