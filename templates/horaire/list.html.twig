{% extends 'base.html.twig' %}

{% block title %}Gestion des horaires{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>🕐 Gestion des horaires</h1>
    <a href="{{ path('app_dashboard_index') }}" class="btn btn-outline-secondary btn-sm">← Dashboard</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-bordered align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Jour</th>
                    <th>Ouverture</th>
                    <th>Fermeture</th>
                    <th>Statut</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                {% for horaire in horaires %}
                <tr>
                    <td><strong>{{ horaire.jourNom }}</strong></td>
                    <td>{{ horaire.estFerme ? '—' : (horaire.heureOuverture ? horaire.heureOuverture|date('H:i') : 'Non défini') }}</td>
                    <td>{{ horaire.estFerme ? '—' : (horaire.heureFermeture ? horaire.heureFermeture|date('H:i') : 'Non défini') }}</td>
                    <td>
                        {% if horaire.estFerme %}
                            <span class="badge bg-danger">Fermé</span>
                        {% else %}
                            <span class="badge bg-success">Ouvert</span>
                        {% endif %}
                    </td>
                    <td>
                        <a href="{{ path('app_horaire_edit', {id: horaire.id}) }}"
                           class="btn btn-sm btn-warning">Modifier</a>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
