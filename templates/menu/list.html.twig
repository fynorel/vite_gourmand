{% extends "base.html.twig" %}

{% block title %}Nos Menus - Vite & Gourmand{% endblock %}

{% block content %}
<h1 class="mb-4">Nos Menus</h1>

<!-- Filtres -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-6">
                <label for="theme" class="form-label">Thème</label>
                <select id="theme" name="theme" class="form-select">
                    <option value="">-- Tous les thèmes --</option>
                    <option value="NOEL" {% if theme_filter == 'NOEL' %}selected{% endif %}>Noël</option>
                    <option value="PAQUES" {% if theme_filter == 'PAQUES' %}selected{% endif %}>Pâques</option>
                    <option value="CLASSIQUE" {% if theme_filter == 'CLASSIQUE' %}selected{% endif %}>Classique</option>
                    <option value="MARIAGE" {% if theme_filter == 'MARIAGE' %}selected{% endif %}>Mariage</option>
                </select>
            </div>
            <div class="col-md-6">
                <label for="regime" class="form-label">Régime</label>
                <select id="regime" name="regime" class="form-select">
                    <option value="">-- Tous les régimes --</option>
                    <option value="CLASSIQUE" {% if regime_filter == 'CLASSIQUE' %}selected{% endif %}>Classique</option>
                    <option value="VEGETARIEN" {% if regime_filter == 'VEGETARIEN' %}selected{% endif %}>Végétarien</option>
                    <option value="VEGAN" {% if regime_filter == 'VEGAN' %}selected{% endif %}>Vegan</option>
                    <option value="SANS_GLUTEN" {% if regime_filter == 'SANS_GLUTEN' %}selected{% endif %}>Sans gluten</option>
                </select>
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-primary">Filtrer</button>
                <a href="{{ path('app_menu_list') }}" class="btn btn-secondary">Réinitialiser</a>
            </div>
        </form>
    </div>
</div>

<!-- Liste des menus -->
<div class="row">
    {% if menus is empty %}
        <div class="col-12">
            <p class="alert alert-info">Aucun menu ne correspond à vos critères.</p>
        </div>
    {% else %}
        {% for menu in menus %}
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">{{ menu.titre }}</h5>
                        <p class="card-text">{{ menu.description|slice(0, 100) }}...</p>
                        
                        <div class="mb-2">
                            <small class="text-muted">
                                <strong>Thème :</strong> {{ menu.theme }}<br>
                                <strong>Régime :</strong> {{ menu.regime }}<br>
                                <strong>Min :</strong> {{ menu.nb_personnes_min }} personnes<br>
                                <strong>Stock :</strong> {{ menu.stock }} disponibles
                            </small>
                        </div>
                    </div>
                    <div class="card-footer bg-white">
                        <div class="d-flex justify-content-between align-items-center">
                            <strong class="text-primary fs-5">{{ menu.prix }}€</strong>
                            <a href="{{ path('app_menu_detail', {'id': menu.id_menu}) }}" class="btn btn-sm btn-primary">
                                Voir plus
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    {% endif %}
</div>
{% endblock %}
