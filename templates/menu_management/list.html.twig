{% extends 'base.html.twig' %}

{% block title %}Gestion des menus{% endblock %}

{% block content %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Gestion des menus</h1>
        <a href="{{ path('app_menu_management_new') }}" class="btn btn-primary">+ Ajouter un menu</a>
    </div>

    <table class="table table-striped table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Titre</th>
                <th>Thème</th>
                <th>Régime</th>
                <th>Prix</th>
                <th>Pers. min</th>
                <th>Stock</th>
                <th>Plats</th>
                <th>Statut</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for menu in menus %}
            <tr>
                <td>{{ menu.titre }}</td>
                <td>{{ menu.theme|capitalize }}</td>
                <td>{{ menu.regime|capitalize }}</td>
                <td>{{ menu.prix }} €</td>
                <td>{{ menu.nbPersonnesMin }}</td>
                <td>{{ menu.stock }}</td>
                <td>
                    {% for plat in menu.plats %}
                        <span class="badge bg-info text-dark">{{ plat.nom }}</span>
                    {% else %}
                        <span class="text-muted">Aucun</span>
                    {% endfor %}
                </td>
                <td>
                    {% if menu.actif %}
                        <span class="badge bg-success">Actif</span>
                    {% else %}
                        <span class="badge bg-secondary">Inactif</span>
                    {% endif %}
                </td>
                <td>
                    <a href="{{ path('app_menu_management_edit', {id: menu.id}) }}"
                       class="btn btn-sm btn-warning">Modifier</a>
                    <form action="{{ path('app_menu_management_delete', {id: menu.id}) }}"
                          method="POST" class="d-inline"
                          onsubmit="return confirm('Supprimer ce menu ?')">
                        <button type="submit" class="btn btn-sm btn-danger">Supprimer</button>
                    </form>
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="9" class="text-center text-muted">Aucun menu enregistré.</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
