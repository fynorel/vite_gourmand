{% extends 'base.html.twig' %}

{% block title %}Gestion des plats{% endblock %}

{% block content %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Gestion des plats</h1>
        <a href="{{ path('app_plat_management_new') }}" class="btn btn-primary">
            + Ajouter un plat
        </a>
    </div>

    <table class="table table-striped table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Nom</th>
                <th>Type</th>
                <th>Description</th>
                <th>Allergènes</th>
                <th>Statut</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for plat in plats %}
            <tr>
                <td>{{ plat.nom }}</td>
                <td>{{ plat.type|capitalize }}</td>
                <td>
                    {{ plat.description|slice(0, 80) }}
                    {% if plat.description|length > 80 %}...{% endif %}
                </td>
                <td>
                    {% for allergene in plat.allergenes %}
                        <span class="badge bg-warning text-dark">{{ allergene.nom }}</span>
                    {% else %}
                        <span class="text-muted">Aucun</span>
                    {% endfor %}
                </td>
                <td>
                    {% if plat.actif %}
                        <span class="badge bg-success">Actif</span>
                    {% else %}
                        <span class="badge bg-secondary">Inactif</span>
                    {% endif %}
                </td>
                <td>
                    <a href="{{ path('app_plat_management_edit', {id: plat.id}) }}"
                       class="btn btn-sm btn-warning">Modifier</a>

                    <form action="{{ path('app_plat_management_delete', {id: plat.id}) }}"
                          method="POST" class="d-inline"
                          onsubmit="return confirm('Supprimer ce plat ?')">
                        <button type="submit" class="btn btn-sm btn-danger">Supprimer</button>
                    </form>
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="6" class="text-center text-muted">Aucun plat enregistré.</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
