{% extends 'base.html.twig' %}

{% block title %}Laisser un avis{% endblock %}

{% block content %}
<div class="row justify-content-center">
<div class="col-md-6">

    <h1 class="mb-2">⭐ Laisser un avis</h1>
    <p class="text-muted mb-4">Menu : <strong>{{ commande.menu.titre }}</strong></p>

    <form method="POST" action="{{ path('app_avis_new', {id: commande.id}) }}">

        <div class="mb-4">
            <label class="form-label fw-bold">Note <span class="text-danger">*</span></label>
            <div class="d-flex gap-3">
                {% for i in 1..5 %}
                <div class="form-check">
                    <input class="form-check-input" type="radio"
                           name="note" value="{{ i }}" id="note_{{ i }}" required>
                    <label class="form-check-label fs-5" for="note_{{ i }}">
                        {{ i }} ⭐
                    </label>
                </div>
                {% endfor %}
            </div>
        </div>

        <div class="mb-4">
            <label for="commentaire" class="form-label fw-bold">
                Commentaire <span class="text-danger">*</span>
            </label>
            <textarea class="form-control" id="commentaire" name="commentaire"
                      rows="5" required
                      placeholder="Partagez votre expérience..."></textarea>
        </div>

        <div class="alert alert-info">
            ℹ️ Votre avis sera visible sur le site après validation par notre équipe.
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-success">Soumettre mon avis</button>
            <a href="{{ path('app_profile') }}" class="btn btn-secondary">Annuler</a>
        </div>

    </form>
</div>
</div>
{% endblock %}
