{% extends "base.html.twig" %}

{% block title %}Mon Profil - Vite & Gourmand{% endblock %}

{% block content %}
<div class="row justify-content-center mb-5">
    <div class="col-md-6">
        <h2 class="mb-4">Mon Profil</h2>

        <form method="post">
            <div class="mb-3">
                <label for="prenom" class="form-label">Prénom</label>
                <input type="text" id="prenom" name="prenom" class="form-control" 
                       value="{{ user.prenom }}" required>
            </div>

            <div class="mb-3">
                <label for="nom" class="form-label">Nom</label>
                <input type="text" id="nom" name="nom" class="form-control" 
                       value="{{ user.nom }}" required>
            </div>

            <div class="mb-3">
                <label for="mail" class="form-label">Email</label>
                <input type="email" id="mail" name="mail" class="form-control" 
                       value="{{ user.mail }}" disabled>
            </div>

            <div class="mb-3">
                <label for="gsm" class="form-label">Téléphone</label>
                <input type="tel" id="gsm" name="gsm" class="form-control" 
                       value="{{ user.gsm ?? '' }}">
            </div>

            <div class="mb-3">
                <label for="adresse" class="form-label">Adresse</label>
                <textarea id="adresse" name="adresse" class="form-control" rows="3">{{ user.adresse ?? '' }}</textarea>
            </div>

            <hr>

            <h5>Changer votre mot de passe</h5>

            <div class="mb-3">
                <label for="password" class="form-label">Nouveau mot de passe</label>
                <input type="password" id="password" name="password" class="form-control">
                <small class="form-text text-muted d-block mt-1">
                    Laissez vide pour ne pas changer
                </small>
            </div>

            <button type="submit" class="btn btn-primary w-100">Mettre à jour</button>
        </form>

        <div class="mt-3">
            <a href="{{ path('app_logout') }}" class="btn btn-danger w-100">Déconnexion</a>
        </div>
    </div>
</div>
{% endblock %}
