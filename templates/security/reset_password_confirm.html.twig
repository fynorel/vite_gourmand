{% extends "base.html.twig" %}

{% block title %}Nouveau mot de passe - Vite & Gourmand{% endblock %}

{% block content %}
<div class="row justify-content-center mb-5">
    <div class="col-md-5">
        <h2 class="mb-4">Changer votre mot de passe</h2>

        <form method="post">
            <div class="mb-3">
                <label for="password" class="form-label">Nouveau mot de passe</label>
                <input type="password" id="password" name="password" class="form-control" required autofocus>
                <small class="form-text text-muted d-block mt-1">
                    Min 10 caractères : 1 majuscule, 1 minuscule, 1 chiffre, 1 spécial
                </small>
            </div>

            <div class="mb-3">
                <label for="password_confirm" class="form-label">Confirmer le mot de passe</label>
                <input type="password" id="password_confirm" name="password_confirm" class="form-control" required>
            </div>

            <button type="submit" class="btn btn-primary w-100">Réinitialiser</button>
        </form>

        <div class="mt-3 text-center">
            <p><a href="{{ path('app_login') }}">Retour à la connexion</a></p>
        </div>
    </div>
</div>
{% endblock %}
